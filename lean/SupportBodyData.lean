def bodyZNeg (p : ZPoint) : ZPoint := (zneg p.1,zneg p.2.1,zneg p.2.2)
def bodyZPoints : List ZPoint := bodyZReps ++ bodyZReps.map bodyZNeg
def bodyRaw (p : ZPoint) : RawPoint :=
  (((p.1.1:ℚ)/800,(p.1.2:ℚ)/800),((p.2.1.1:ℚ)/800,(p.2.1.2:ℚ)/800),
   ((p.2.2.1:ℚ)/800,(p.2.2.2:ℚ)/800))
noncomputable def bodyEval (p : ZPoint) : Point := (1/800:ℝ) • zpoint p
theorem body_raw_exact : bodyZPoints.map bodyRaw = vertices := by
  norm_num [bodyZPoints,bodyZReps,bodyZNeg,zneg,bodyRaw,vertices,representatives,rawNeg,qneg]
theorem body_eval_exact (p : ZPoint) : bodyEval p=evalPoint (Real.sqrt 5) (bodyRaw p) := by
  ext <;> simp [bodyEval,zpoint,zeval,evalPoint,eval,bodyRaw] <;> ring
theorem body_mem (p : ZPoint) (hp : p ∈ bodyZPoints) : bodyEval p ∈ VertexSet (Real.sqrt 5) := by
  refine ⟨bodyRaw p, ?_,(body_eval_exact p).symm⟩
  rw [← body_raw_exact]
  exact List.mem_map.mpr ⟨p,hp,rfl⟩
theorem body_vertex_elim (Q : Point → Prop)
    (hq : ∀ p ∈ bodyZPoints, Q (bodyEval p)) : ∀ p ∈ VertexSet (Real.sqrt 5), Q p := by
  rintro p ⟨raw,hr,rfl⟩
  rw [← body_raw_exact] at hr
  obtain ⟨q,hq',rfl⟩ := List.mem_map.mp hr
  rw [← body_eval_exact]
  exact hq q hq'
theorem body_support_at_z5 (n p : ZPoint)
    (hc : ∀ q ∈ bodyZPoints, ZNonneg (zdot n (zpsub p q))) :
    ∀ q ∈ VertexSet (Real.sqrt 5), dot (zpoint n) q ≤ dot (zpoint n) (bodyEval p) := by
  apply body_vertex_elim
  intro q hq
  have h := znonneg_sound _ (hc q hq)
  have hid : dot (zpoint n) (bodyEval p)-dot (zpoint n) (bodyEval q)=
      zeval (zdot n (zpsub p q))/800 := by
    rw [zeval_dot,zpoint_sub]
    dsimp [bodyEval,dot]
    ring
  linarith
end Phinopert
