/-- This remains conditional until each actual original-root exclusion is
supplied by an audited theorem. It does not assert non-Rupertness by itself. -/
theorem original_roots_imply_no_proper_shadow_fit
    (hexclude : ∀ i : Fin 432, ∀ s t r, InClosedBox (originalRootBox i) s t r →
      InIcoDomain s t r → ¬ StrictShadowFit s t r 0) : NoProperShadowFit := by
  apply no_proper_shadow_fit_of_domain_exclusion
  intro s t r hd
  obtain ⟨i,hb⟩ := original_roots_cover s t r hd
  exact hexclude i s t r hb hd
end Phinopert
#print axioms Phinopert.original_roots_cover
#print axioms Phinopert.original_roots_imply_no_proper_shadow_fit
