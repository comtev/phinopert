def vertices : List RawPoint := representatives ++ representatives.map rawNeg
set_option maxRecDepth 100000 in
theorem vertex_list_length : vertices.length = 180 := by decide

theorem raw_neg_involution (p : RawPoint) : rawNeg (rawNeg p) = p := by
  rcases p with ⟨⟨a,b⟩,⟨c,d⟩,⟨e,f⟩⟩
  simp [rawNeg,qneg]

theorem raw_neg_closed {p : RawPoint} (hp : p ∈ vertices) : rawNeg p ∈ vertices := by
  change p ∈ representatives ++ representatives.map rawNeg at hp
  change rawNeg p ∈ representatives ++ representatives.map rawNeg
  rcases List.mem_append.mp hp with h | h
  · exact List.mem_append.mpr (Or.inr (List.mem_map.mpr ⟨p,h,rfl⟩))
  · obtain ⟨q,hq,rfl⟩ := List.mem_map.mp h
    exact List.mem_append.mpr (Or.inl (by simpa [raw_neg_involution] using hq))
end Phinopert
